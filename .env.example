# Copy to .env. Never put server secrets in NEXT_PUBLIC_* variables.
DATABASE_URL="postgresql://app_user:replace_me@127.0.0.1:5432/app_database?schema=public"
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"
NEXTAUTH_URL="http://localhost:5700"
PORT="5700"
HOST="127.0.0.1"
INITIAL_ADMIN_EMAIL="admin@ai-certified-payroll-and-prevailing-wage-control.local"
INITIAL_ADMIN_PASSWORD="replace-with-16-or-more-random-characters"
SEED_DEMO_DATA="false"
AUTH_COOKIE_SECURE="false"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_HTTP_REFERER="http://localhost:5700"
OPENROUTER_APP_TITLE="Certified Payroll and Prevailing Wage Control"
OPENROUTER_ALLOWED_MODELS=""
OPENROUTER_TIMEOUT_MS="60000"
OPENROUTER_TEMPERATURE="0.2"
OPENROUTER_MAX_TOKENS="4000"
# Optional parameters: leave empty to omit. Model support varies.
OPENROUTER_MAX_COMPLETION_TOKENS=""
OPENROUTER_TOP_P=""
OPENROUTER_TOP_K=""
OPENROUTER_MIN_P=""
OPENROUTER_TOP_A=""
OPENROUTER_FREQUENCY_PENALTY=""
OPENROUTER_PRESENCE_PENALTY=""
OPENROUTER_REPETITION_PENALTY=""
OPENROUTER_SEED=""
OPENROUTER_REASONING_EFFORT=""
OPENROUTER_REASONING_JSON=""
OPENROUTER_PROVIDER_JSON=""
OPENROUTER_STOP_JSON=""
OPENROUTER_LOGIT_BIAS_JSON=""
OPENROUTER_MODELS_JSON=""
OPENROUTER_ROUTE=""
OPENROUTER_SERVICE_TIER=""
OPENROUTER_USER=""
OPENROUTER_SESSION_ID=""
OPENROUTER_METADATA_JSON=""
OPENROUTER_PLUGINS_JSON=""
OPENROUTER_LOGPROBS=""
OPENROUTER_TOP_LOGPROBS=""
OPENROUTER_EXTRA_PARAMETERS_JSON="{}"
DOMAIN_CONNECTORS_JSON="[]"

# Optional credential-fill button for loopback-bound local development only.
LOCAL_LOGIN_HELPER="false"
